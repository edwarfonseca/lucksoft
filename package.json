{
  "name": "lucksoft",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma educativa de programación (Fase 1: vanilla + localStorage; en migración a React+TS+Supabase).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"LuckSoft/**/*.{js,html,css,md}\" \"*.{json,md,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"LuckSoft/**/*.{js,html,css,md}\" \"*.{json,md,ts}\"",
    "start:legacy": "python LuckSoft/server.py"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@uiw/react-codemirror": "^4.25.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0",
    "zod": "^4.4.3"
  }
}
